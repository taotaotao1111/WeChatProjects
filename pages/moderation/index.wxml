<view class="screen">
  <view wx:if="{{loading}}" class="surface empty">正在读取审核记录…</view>
  <view wx:elif="{{error}}" class="surface empty">
    <view class="empty-title">{{error}}</view>
    <button class="empty-action" bindtap="reload">重试</button>
  </view>
  <block wx:else>
    <view class="page-title">待审核认证</view>
    <view wx:for="{{verifications}}" wx:key="id" class="surface moderation-card">
      <view class="field-label">{{item.name}} · {{item.college}}</view>
      <view>{{item.major}} · {{item.year}} 届 · {{item.degree}}</view>
      <view class="moderation-actions">
        <button size="mini" class="moderation-action moderation-action--secondary" data-id="{{item.id}}" data-type="verification" data-status="rejected"
          bindtap="handleDecision" disabled="{{busy}}">不通过</button>
        <button size="mini" class="primary-button moderation-action" data-id="{{item.id}}" data-type="verification" data-status="approved"
          bindtap="handleDecision" disabled="{{busy}}">通过认证</button>
      </view>
    </view>
    <view wx:if="{{!verifications.length}}" class="surface empty">暂无待审核认证</view>

    <view class="page-title moderation-heading">待处理举报</view>
    <view wx:for="{{reports}}" wx:key="id" class="surface moderation-card">
      <navigator class="field-label" url="/pages/detail/index?id={{item.postId}}">{{item.title}} ›</navigator>
      <view>{{item.reason}}</view>
      <view class="moderation-actions">
        <button wx:if="{{item.status !== 'withdrawing'}}" size="mini" class="moderation-action moderation-action--secondary" data-id="{{item.id}}" data-type="report" data-status="dismissed"
          bindtap="handleDecision" disabled="{{busy}}">驳回举报</button>
        <button size="mini" class="primary-button moderation-action" data-id="{{item.id}}" data-type="report" data-status="withdrawn"
          bindtap="handleDecision" disabled="{{busy}}">{{item.status === 'withdrawing' ? '继续下架' : '下架信息'}}</button>
      </view>
    </view>
    <view wx:if="{{!reports.length}}" class="surface empty">暂无待处理举报</view>
  </block>
</view>
