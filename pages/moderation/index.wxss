.moderation-heading {
  margin-top: 32rpx;
}

.moderation-card {
  margin-top: 16rpx;
  padding: 24rpx;
}

.moderation-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}

.moderation-actions .moderation-action {
  width: auto;
  margin: 0;
  min-height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  line-height: 56rpx;
}

@media (prefers-color-scheme: dark) {
  .moderation-card { color: var(--dark-body); }

  .moderation-actions .moderation-action--secondary {
    background: var(--dark-inset);
    color: var(--dark-text);
  }
}
