.detail-header,
.detail-section,
.request-status {
  margin-bottom: 20rpx;
  padding: 27rpx 28rpx;
}

.detail-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.detail-validity,
.detail-meta {
  color: #586e85;
  font-size: 23rpx;
  line-height: 1.6;
}

.detail-title {
  margin: 18rpx 0 12rpx;
  font-size: 43rpx;
  font-weight: 750;
  line-height: 1.3;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.fact-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.fact {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f0f4f9;
}

.fact-label {
  margin-bottom: 5rpx;
  color: #586e85;
  font-size: 22rpx;
}

.fact-value {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
}

.description-title {
  margin-top: 30rpx;
}

.description {
  display: block;
  color: #3c536c;
  font-size: 27rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.author {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.author-avatar {
  display: flex;
  flex: none;
  justify-content: center;
  align-items: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #dce9f8;
  color: #23558a;
  font-size: 31rpx;
  font-weight: 650;
}

.author-avatar--request {
  background: #f5ebd8;
  color: #805d28;
}

.author-info {
  min-width: 0;
}

.author-name-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7rpx 12rpx;
  margin-bottom: 5rpx;
}

.author-name {
  font-size: 28rpx;
  font-weight: 700;
}

.author-verified {
  padding: 3rpx 9rpx;
  border-radius: 7rpx;
  background: #e6f5ed;
  color: #166449;
  font-size: 20rpx;
}

.author-profile,
.request-status-note {
  color: #586e85;
  font-size: 24rpx;
  line-height: 1.55;
}

.request-status {
  border-color: #d6e4f5;
  background: #edf4fc;
}

.request-status-title {
  margin-bottom: 5rpx;
  color: #173d65;
  font-size: 29rpx;
  font-weight: 700;
}

.request-message {
  display: block;
  margin-top: 16rpx;
  padding-top: 13rpx;
  border-top: 2rpx solid #d6e4f5;
  color: #3c536c;
  font-size: 25rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.back-link {
  margin-top: 14rpx;
  color: #23558a;
}

.detail-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.detail-actions button.primary-button {
  flex: 1;
  min-width: 0;
}

button.favorite-button {
  flex: none;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 22rpx;
  border-radius: 18rpx;
  background: #eef3f8;
  color: #173d65;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 60rpx;
}
