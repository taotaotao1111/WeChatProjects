<view class="screen tab-screen">
  <view class="message-tabs" aria-label="消息类型">
    <button class="message-tab {{active === item.key ? 'message-tab--active' : ''}}" wx:for="{{tabs}}"
      wx:key="key" data-key="{{item.key}}" bindtap="selectTab" aria-pressed="{{active === item.key}}">{{item.label}}</button>
  </view>
  <view wx:if="{{loadFailed}}" class="surface empty">
    <view class="empty-title">暂时无法读取消息</view>
    <text>切换页面后再试一次。</text>
  </view>
  <view wx:elif="{{loading}}" class="surface empty">正在加载消息…</view>
  <block wx:elif="{{active === 'incoming'}}">
    <view wx:for="{{incoming}}" wx:key="id" class="surface message-entry">
      <view class="message-heading">
        <view class="message-avatar">{{item.initial}}</view>
        <view class="message-person">
          <view class="message-title">{{item.name}}</view>
          <view class="message-meta">{{item.subject}}</view>
        </view>
        <text wx:if="{{!usingCloud}}" class="message-meta">示例</text>
      </view>
      <view class="message-body">{{item.message}}</view>
      <view wx:if="{{item.status === 'pending'}}" class="responses">
        <button class="response" data-status="declined" data-id="{{item.id}}" bindtap="respond" disabled="{{responding}}">拒绝</button>
        <button class="response response--primary" data-status="accepted" data-id="{{item.id}}" bindtap="respond" disabled="{{responding}}">同意联系</button>
      </view>
      <view wx:else class="response-status">{{item.status === 'accepted' ? '已同意联系' : '已拒绝'}}</view>
    </view>
    <view wx:if="{{!incoming.length}}" class="surface empty">还没有收到联系申请</view>
  </block>
  <block wx:elif="{{active === 'outgoing'}}">
    <navigator wx:for="{{outgoing}}" wx:key="postId" class="surface message-entry" url="/pages/detail/index?id={{item.postId}}">
      <view class="message-title">{{item.post.title}}</view>
      <view class="message-meta">联系 {{item.post.author.name}} · {{item.status === 'accepted' ? '已同意联系' : item.status === 'declined' ? '已拒绝' : '等待对方处理'}}</view>
      <view class="message-body">{{item.message}}</view>
    </navigator>
    <view wx:if="{{!outgoing.length}}" class="surface empty">还没有发出的申请</view>
  </block>
  <block wx:else>
    <view wx:for="{{notices}}" wx:key="id" class="surface message-entry">
      <view class="message-title">{{item.title}}</view>
      <view class="message-meta">{{item.description}}</view>
    </view>
    <view wx:if="{{!notices.length}}" class="surface empty">暂无系统通知</view>
  </block>
</view>
