.message-tabs {
  display: flex;
  gap: 6rpx;
  margin-bottom: 20rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  background: #e8eef5;
}

.message-tabs .message-tab {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 15rpx;
  background: transparent;
  color: #4e647d;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 66rpx;
}

.message-tabs .message-tab--active {
  background: #173d65;
  color: #fff;
}

.message-tab-count {
  display: inline-block;
  min-width: 24rpx;
  margin-left: 5rpx;
  padding: 0 5rpx;
  border-radius: 20rpx;
  background: #c13441;
  color: #fff;
  font-size: 17rpx;
  line-height: 27rpx;
  text-align: center;
  vertical-align: middle;
}

.message-entry {
  display: block;
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.message-heading,
.responses {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.message-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #dce9f8;
  color: #173d65;
  font-weight: 700;
}

.message-person {
  flex: 1;
}

.message-title {
  color: #16263b;
  font-size: 29rpx;
  font-weight: 700;
}

.message-meta,
.response-status {
  margin-top: 6rpx;
  color: #536981;
  font-size: 23rpx;
}

.message-body {
  margin-top: 15rpx;
  padding: 15rpx;
  border-radius: 12rpx;
  background: #eef3f8;
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-word;
}

.responses {
  justify-content: flex-end;
  margin-top: 16rpx;
}

.screen .response {
  margin: 0;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #e8eef5;
  color: #173d65;
  font-size: 24rpx;
  line-height: 62rpx;
}

.screen .response--primary {
  background: #173d65;
  color: #fff;
}

.response-status {
  margin-top: 17rpx;
  text-align: right;
  font-weight: 700;
}

.contact-share {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #f2f6fb;
}

.contact-share-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.contact-share-row + .contact-share-row,
.contact-share-row + .contact-share-note,
.contact-share-note + .contact-share-note {
  margin-top: 12rpx;
}

.contact-share-info {
  min-width: 0;
  word-break: break-word;
}

.contact-share-label,
.contact-share-value {
  display: block;
}

.contact-share-label,
.contact-share-note {
  color: #536981;
  font-size: 23rpx;
  line-height: 1.5;
}

.contact-share-value {
  margin-top: 3rpx;
  color: #16263b;
  font-size: 27rpx;
  font-weight: 650;
}

.contact-share .contact-share-action {
  flex: none;
  width: auto;
  min-height: 60rpx;
  line-height: 60rpx;
}

@media (prefers-color-scheme: dark) {
  .message-tabs,
  .message-body,
  .contact-share { background: var(--dark-inset); }

  .message-tabs .message-tab,
  .message-meta,
  .response-status,
  .contact-share-label,
  .contact-share-note { color: var(--dark-muted); }

  .message-title,
  .contact-share-value { color: var(--dark-text); }
  .message-body { color: var(--dark-body); }

  .message-avatar,
  .screen .response {
    background: var(--dark-inset);
    color: var(--dark-accent);
  }

  .message-tabs .message-tab--active,
  .screen .response--primary {
    background: var(--dark-primary);
    color: #fff;
  }
}
