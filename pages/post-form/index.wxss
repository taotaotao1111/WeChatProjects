.post-form-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.form-count {
  margin-top: 8rpx;
  color: #596d83;
  text-align: right;
  font-size: 22rpx;
}

.post-highlight-fields {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #e7edf4;
}

.post-highlight-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
  color: #173d65;
  font-size: 27rpx;
  font-weight: 700;
}

.post-highlight-optional {
  color: #536981;
  font-size: 22rpx;
  font-weight: 400;
}

@media (prefers-color-scheme: dark) {
  .form-count,
  .post-highlight-optional { color: var(--dark-muted); }
  .post-highlight-fields { border-color: var(--dark-border); }
  .post-highlight-heading { color: var(--dark-text); }
}
