.hero {
  position: relative;
  min-height: 248rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: #102d55;
  color: #fff;
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-content {
  position: relative;
  z-index: 1;
  padding: 28rpx 34rpx 30rpx;
}

.hero-location {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #f1d498;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.location-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #e4ba71;
  box-shadow: 0 0 0 5rpx rgba(228, 186, 113, 0.18);
}

.hero-title {
  margin-top: 16rpx;
  font-size: 47rpx;
  line-height: 1.25;
  font-weight: 750;
  letter-spacing: 1rpx;
}

.hero-caption {
  margin-top: 12rpx;
  color: #d9e5f5;
  font-size: 24rpx;
  line-height: 1.5;
}


.latest-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 26rpx 0 12rpx;
}

.latest-title {
  font-size: 37rpx;
  font-weight: 750;
}

button.latest-link {
  display: inline-flex;
  align-items: center;
  width: auto;
  flex: none;
  margin: 0;
  padding: 10rpx 0 10rpx 14rpx;
  border-radius: 0;
  background: transparent;
  color: #32689b;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}

button.latest-link--reset {
  gap: 6rpx;
  min-height: 52rpx;
  padding: 0 14rpx;
  border: 2rpx solid #e2e9f1;
  border-radius: 14rpx;
  background: #fff;
  color: #50657e;
  font-size: 22rpx;
}

button.latest-link--pressed {
  background: #eaf0f7;
}

.reset-icon {
  color: #41668b;
  font-size: 27rpx;
  line-height: 1;
}

.search {
  display: flex;
  align-items: center;
  gap: 19rpx;
  min-height: 84rpx;
  margin: 18rpx 0 22rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
}

.search-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  margin-right: 5rpx;
  box-sizing: border-box;
  border: 3rpx solid #58728d;
  border-radius: 50%;
}

.search-icon::after {
  position: absolute;
  right: -9rpx;
  bottom: -4rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #58728d;
  content: "";
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 28rpx;
}

.search-placeholder {
  color: #64758a;
}

button.search-clear {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  margin: 0 -12rpx 0 0;
  padding: 0;
  border-radius: 50%;
  background: #f1f4f8;
  color: #42607e;
  font-size: 36rpx;
  line-height: 56rpx;
}

.filters {
  display: flex;
  gap: 6rpx;
  margin: 0 0 18rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  background: #e8eef5;
}

button.filter {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 15rpx;
  background: transparent;
  color: #4e647d;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 66rpx;
}

button.filter--active {
  background: #173d65;
  color: #fff;
}

.post {
  display: block;
  margin-bottom: 18rpx;
  padding: 24rpx 26rpx 20rpx;
}

.post--pressed {
  background: #edf3f9;
}

.post-top,
.post-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.post-validity,
.post-meta {
  color: #596d83;
  font-size: 23rpx;
  line-height: 1.5;
}

.post-title {
  margin-top: 13rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.38;
}

.post-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 7rpx;
  color: #536981;
  font-size: 25rpx;
  line-height: 1.6;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.post-bottom {
  margin-top: 16rpx;
  padding-top: 13rpx;
  border-top: 2rpx solid #edf1f6;
}

.post-arrow {
  flex: none;
  color: #32689b;
  font-size: 37rpx;
  line-height: 0.9;
}

.home-brand {
  font-size: 38rpx;
  font-weight: 750;
}

.home-categories {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 4rpx;
  margin-top: 24rpx;
}

button.home-category {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0 0 6rpx;
  border-radius: 0;
  background: transparent;
  color: #16263b;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.45;
}

.category-icon {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 76rpx;
  height: 76rpx;
  margin-bottom: 8rpx;
  border-radius: 50%;
  background: #eaf0f7;
}

.category-icon--active {
  background: #d6e6f6;
  box-shadow: inset 0 0 0 2rpx #678fb8;
}

.category-image {
  display: block;
  width: 47rpx;
  height: 47rpx;
}

.category-name {
  white-space: nowrap;
}

@media (prefers-color-scheme: dark) {
  .hero-image { opacity: 0.7; }
  .home .latest-link,
  .reset-icon,
  .post-arrow { color: var(--dark-accent); }

  .home .latest-link--reset,
  .home .search-clear {
    background: var(--dark-inset);
    border-color: var(--dark-border);
  }

  .search-icon { border-color: var(--dark-muted); }
  .search-icon::after { background: var(--dark-muted); }
  .search-input,
  .home .home-category { color: var(--dark-text); }

  .search-placeholder,
  .post-validity,
  .post-meta,
  .home .filter { color: var(--dark-muted); }

  .post-summary { color: var(--dark-body); }
  .post-bottom { border-color: var(--dark-border); }
  .filters,
  .category-icon { background: var(--dark-inset); }

  .home .filter--active {
    background: var(--dark-primary);
    color: #fff;
  }

  .home .post--pressed,
  .home .latest-link--pressed { background: var(--dark-pressed); }

  .category-icon--active {
    background: #284867;
    box-shadow: inset 0 0 0 2rpx #547ea5;
  }

  .category-image { filter: brightness(0) invert(0.82); }
}
