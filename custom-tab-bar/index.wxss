.bottom-tabs {
  position: fixed;
  z-index: 30;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: stretch;
  height: 102rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 2rpx solid #e7edf4;
  background: #fff;
  color: #536981;
}

.bottom-tabs .bottom-tab {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  min-width: 0;
  margin: 0;
  padding: 8rpx 0 13rpx;
  border: 0;
  border-radius: 0;
  overflow: visible;
  background: transparent;
  color: inherit;
  font-size: 21rpx;
  font-weight: 550;
  line-height: 1.35;
}

.bottom-tab::after {
  border: 0;
}

.bottom-tabs .bottom-tab--selected {
  color: #173d65;
  font-weight: 750;
}

.tab-icon {
  display: block;
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 2rpx;
}

.tab-icon-wrap {
  position: relative;
}

.tab-count {
  position: absolute;
  top: 0;
  left: 39rpx;
  min-width: 26rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border: 2rpx solid #fff;
  border-radius: 20rpx;
  background: #c13441;
  color: #fff;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 23rpx;
  text-align: center;
  white-space: nowrap;
}

.publish-badge {
  display: flex;
  flex: none;
  justify-content: center;
  align-items: center;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 3rpx;
  box-sizing: border-box;
  border: 5rpx solid #fff;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 3rpx 15rpx rgba(23, 61, 101, 0.2);
}

.publish-logo {
  position: relative;
  overflow: hidden;
  width: 73rpx;
  height: 73rpx;
  border-radius: 50%;
}

/* Frame the round seal within the school's official reference image. */
.publish-logo-sheet {
  position: absolute;
  top: -21.5rpx;
  left: -15rpx;
  width: 104rpx;
  height: 149rpx;
}

.bottom-tab--selected .publish-badge {
  border-color: #e1ebf6;
}

@media (prefers-color-scheme: dark) {
  .bottom-tabs {
    background: #17191c;
    border-color: #363c44;
    color: #b2bbc5;
  }

  .bottom-tabs .bottom-tab--selected { color: #9acbff; }
  .tab-icon { filter: brightness(0) invert(0.72); }
  .bottom-tab--selected .tab-icon { filter: brightness(0) invert(0.94); }
  .tab-count { border-color: #17191c; }

  .publish-badge {
    background: #292d33;
    border-color: #484e56;
    box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.3);
  }

  .bottom-tab--selected .publish-badge { border-color: #9acbff; }
}
