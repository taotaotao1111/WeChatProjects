<view class="bottom-tabs" aria-label="底部导航">
  <button wx:for="{{tabs}}" wx:key="route" class="bottom-tab {{selectedRoute === item.route ? 'bottom-tab--selected' : ''}}"
    bindtap="switchTab" data-route="{{item.route}}" aria-pressed="{{selectedRoute === item.route}}">
    <view wx:if="{{item.icon === 'publish'}}" class="publish-badge">
      <view class="publish-logo" aria-hidden="true">
        <image class="publish-logo-sheet" src="/images/whut-emblem.png" mode="scaleToFill" />
      </view>
    </view>
    <view wx:else class="tab-icon-wrap">
      <image class="tab-icon"
        src="/images/icons/alumni-{{item.icon}}{{selectedRoute === item.route ? '-active' : ''}}.png" aria-hidden="true" />
      <text wx:if="{{item.icon === 'messages' && pendingContactCount > 0}}" class="tab-count"
        aria-label="{{pendingContactCount}} 条待处理申请">{{pendingContactCount > 99 ? '99+' : pendingContactCount}}</text>
    </view>
    <text class="tab-label">{{item.label}}</text>
  </button>
</view>
